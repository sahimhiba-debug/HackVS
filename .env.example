# Copier en .env sur le serveur (cp .env.example .env), puis remplir. JAMAIS de .env dans le dépôt.
# Valeurs vides = à fournir par Hiba (voir docs/DEPLOIEMENT.md, « ce qu'Hiba doit fournir »).

# Domaine pointé vers le VPS (enregistrement DNS A/AAAA), ex. pulse.mondomaine.ch — sans https://
DOMAINE=
# URL publique : tout lien et tout QR produit par le serveur en part — https:// + DOMAINE, sans barre finale
PUBLIC_BASE_URL=

# Secret de session (≥ 32 caractères, STABLE) : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HACKVS_SECRET=
# Jeton de la console (écran géant, télécommande, Établi, Suivi) : obligatoire derrière un proxy
HACKVS_CONSOLE_JETON=

# Interrupteurs (1 = allumé)
HACKVS_FOIRE=1
HACKVS_SALLE=1
HACKVS_SALLE_PLAFOND=80
HACKVS_SALLE_MIN=5

# IA (facultatif : sans clé, forme déterministe, dite à l'écran)
APERTUS_API_KEY=
APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B
APERTUS_BASE_URL=https://api.inference.cscs.ch/v1
