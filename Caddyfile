# HTTPS automatique (Let's Encrypt) pour le domaine de .env (DOMAINE) ; tout le trafic vers l'application.
{$DOMAINE} {
	encode zstd gzip
	reverse_proxy app:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# Monde « visite » (bac à sable fictif, console ouverte) : un sous-domaine à part
{$DOMAINE_VISITE} {
	encode zstd gzip
	reverse_proxy visite:8080
}
